# Copy to .env and fill in. NEVER commit .env (it is in .gitignore).

# Google Ads API
GOOGLE_ADS_DEVELOPER_TOKEN=your-developer-token
GOOGLE_ADS_CLIENT_ID=your-oauth-client-id
GOOGLE_ADS_CLIENT_SECRET=your-oauth-client-secret
GOOGLE_ADS_REFRESH_TOKEN=your-refresh-token
GOOGLE_ADS_CUSTOMER_ID=1234567890
GOOGLE_ADS_LOGIN_CUSTOMER_ID=1234567890   # the manager (MCC) account, if you use one

# Meta Marketing API / Conversions API
META_ACCESS_TOKEN=your-system-user-token
META_AD_ACCOUNT_ID=act_1234567890
META_PIXEL_ID=1234567890

# CRM (GoHighLevel)
GHL_API_KEY=your-crm-api-key
GHL_LOCATION_ID=your-location-id
GHL_PIPELINE_ID=your-pipeline-id

# Optional threshold overrides (see the top of each script)
# LEAK_EXPENSIVE_TERM=12
# LEAK_DAY_SPIKE=180
# LEAK_CPC_CAP=12
# PIXEL_MIN_PAGEVIEWS=5
# CAPI_CURRENCY=CAD
